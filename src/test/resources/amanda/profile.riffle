schemaVersion : 1
provider : chatgpt
model : gpt-6-sol
transport : chatgpt-oauth
capabilities : {
    tools : true
    streaming : true
    contextWindow : 272000
    maxOutputTokens : 128000
    reasoning : [
        none
        low
        medium
        high
        xhigh
        max
    ]
    defaultReasoning : high
    tokenizer : heuristic
    replayRequirements : [
        chatgpt-oauth
    ]
}
options : {
    chatgpt-oauth : {}
}
