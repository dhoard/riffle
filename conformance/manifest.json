        },
        {
          "path": "literalQuotes",
          "kind": "string",
          "value": "\"quoted\""
        },
        {
          "path": "trailingQuote",
          "kind": "string",
          "value": "hello\""
        },
        {
          "path": "empty",
          "kind": "string",
          "value": ""
        },
        {
          "path": "hashComment",
          "kind": "string",
          "value": "a # b"
        },
        {
          "path": "slashComment",
          "kind": "string",
          "value": "a // b"
        },
        {
          "path": "ambiguousBoundary",
          "kind": "string",
          "value": "a"
        },
        {
          "path": "escapedBoundary",
          "kind": "string",
          "value": "a\" # text"
        },
        {
          "path": "bareQuotes",
          "kind": "string",
          "value": "He said \"hello\""
        },
        {
          "path": "escapedBackslash",
          "kind": "string",
          "value": "line \\n"
        },
        {
          "path": "escapedNewline",
          "kind": "string",
          "value": "line \n"
        },
        {
          "path": "canonicalLiteral",
          "kind": "string",
          "value": "  He said \"hello\"  "
        },
        {
          "path": "typed",
          "kind": "string",
          "value": "He said \"hello\""
        },
        {
          "path": "list[0]",
          "kind": "string",
          "value": "one \"two\""
        },
        {
          "path": "list[1]",
          "kind": "string",
          "value": "a # b"
        },
        {
          "path": "typedList[0]",
          "kind": "string",
          "value": "He said \"hello\""
        }
      ]
    },
