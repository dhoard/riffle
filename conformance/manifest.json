      "expectedCanonical": "canonical/eol-quoted-strings-expected.riffle",
      "semantics": [
        {
          "path": "literal",
          "kind": "string",
          "value": "He said \"hello\""
        },
        {
          "path": "escaped",
          "kind": "string",
