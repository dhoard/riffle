{
  "schemaVersion": 1,
  "description": "Language-neutral Riffle 0.1.0 conformance cases. See conformance/README.md.",
  "defaultEncoding": "UTF-8",
  "defaultLineEndings": "LF",
  "cases": [
    {
      "id": "valid.strings",
      "expectation": "valid",
      "input": "valid/strings.riffle",
      "expectedCanonical": "canonical/strings-expected.riffle",
      "semantics": [
        {
          "path": "empty",
          "kind": "string",
          "value": ""
        },
        {
          "path": "stringTrue",
          "kind": "string",
          "value": "true"
        },
        {
          "path": "stringNull",
          "kind": "string",
          "value": "null"
        },
        {
          "path": "bareWithHash",
          "kind": "string",
          "value": "https://example.org/a#fragment"
        },
        {
          "path": "bareWithSlashes",
          "kind": "string",
          "value": "path//segment"
        },
        {
          "path": "display name",
          "kind": "string",
          "value": "Jane Doe"
        },
        {
          "path": "escaped",
          "kind": "string",
          "value": "line one\nline two ☺"
        },
        {
          "path": "literalAt",
          "kind": "string",
          "value": "@int 123"
        },
        {
          "path": "equals",
          "kind": "string",
          "value": "a=b"
        },
        {
          "path": "absent",
          "kind": "missing"
        }
      ]
    },
