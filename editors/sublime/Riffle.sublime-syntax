%YAML 1.2
---
# Sublime Text syntax definition for Riffle 0.1.0.
#
# The normative grammar is LANGUAGE_SPEC.md at the repository root. Riffle is
# line oriented: a map entry or array element occupies exactly one line, a
# nonempty collection opens at the end of a line and closes on a line of its
# own, and strings never span lines. The contexts below are therefore built
# around whole lines.
#
# The rules follow the specification's less obvious corners:
#   * `#` and `//` start a comment only at the start of a line or after
#     whitespace, so `https://example.org/a#fragment` and `path//segment` stay
#     bare strings.
#   * A quoted *value* is delimited by the last quote that leaves only
#     whitespace or an inline comment before the end of the line, so
#     `"He said "hello""` is one string containing quotes.
#   * A quoted *key* ends at the first unescaped quote, because a key ends at
#     `=` rather than at the end of the line.
#
# Semantic errors are deliberately not detected: duplicate keys, integer range
# overflow, and malformed UTF-8 are parser or runtime concerns, not syntax.
name: Riffle
file_extensions:
  - riffle
scope: source.riffle
version: 2

variables:
  # Whitespace, an optional inline comment, and the end of the line.
  eol: '[ \t]*(?:(?:#|//).*)?$'
  # A bare value: runs to the end of the line and ends at whitespace that is
  # followed by a comment marker.
  bare_string: '\S(?:.*?)(?=[ \t]+(?:#|//)|[ \t]*$)'
  integer: '-?(?:0|[1-9][0-9]*)'
  decimal: '-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?'
  # After `@type [`, either the line ends (block form) or an immediately
  # closing `]` ends it (inline empty form); `@type [ ]` is invalid.
  typed_array_open: '(?:\](?:[ \t]*(?:(?:#|//).*)?)?|[ \t]*(?:(?:#|//).*)?)$'

contexts:
  # The document root is an implicit map: every line is a map entry, a blank
  # line or a comment. A collection or a closer may not appear at the root.
  main:
    - match: '^([ \t]*)([\}\]])'
      captures:
        2: invalid.illegal.unexpected-closer.riffle
    - match: '^([ \t]*)([\{\[])'
      captures:
        2: invalid.illegal.unexpected-collection.riffle
    - include: map-entries

  # Body of a nested map, entered after a `key = {` line.
  map-body:
    - match: '^([ \t]*)(\})'
      captures:
        2: punctuation.section.mapping.end.riffle
      pop: true
    - match: '^([ \t]*)(\])'
      captures:
        2: invalid.illegal.mismatched-closer.riffle
    - include: map-entries

  # One `key = value` line of a map, and the value that follows it. Rule order
  # matters: comments are recognized before a value, and a bare value is the
  # last resort.
  map-entries:
    - include: comments
    - include: map-entry
    - match: '^([ \t]*)({{bare_string}})'
      captures:
        2: invalid.illegal.missing-equals.riffle
    - include: inline-comment
    - include: value-start

  map-entry:
    # Bare key: [A-Za-z0-9_][A-Za-z0-9_.-]*, followed by `=`.
    - match: '^([ \t]*)([A-Za-z0-9_][A-Za-z0-9_.-]*)([ \t]*)(=)'
      captures:
        2: entity.name.tag.riffle
        4: keyword.operator.assignment.riffle
    # Quoted key: ends at the first unescaped quote and must be followed by `=`.
    - match: '^([ \t]*)(")((?:[^"\\]|\\.)*)(")([ \t]*)(=)'
      captures:
        2: punctuation.definition.string.begin.riffle
        3: string.quoted.double.riffle
        4: punctuation.definition.string.end.riffle
        6: keyword.operator.assignment.riffle

  # Body of an untyped array, entered after a `key = [` line or an element
  # line that opens a nested array.
  array-body:
    - match: '^([ \t]*)(\])'
      captures:
        2: punctuation.section.array.end.riffle
      pop: true
    - match: '^([ \t]*)(\})'
      captures:
        2: invalid.illegal.mismatched-closer.riffle
    - include: comments
    - include: inline-comment
    - include: value-start

  comments:
    - match: '^([ \t]*)(#.*)$'
      captures:
        2: comment.line.number-sign.riffle
    - match: '^([ \t]*)(//.*)$'
      captures:
        2: comment.line.double-slash.riffle

  # `#` and `//` start a comment only when whitespace precedes them. Without
  # that whitespace a marker is part of a bare value, which is why the value
  # rules consume it first.
  inline-comment:
    - match: '(?<=[ \t])(#.*)$'
      scope: comment.line.number-sign.riffle
    - match: '(?<=[ \t])(//.*)$'
      scope: comment.line.double-slash.riffle

  # A value beginning at the current position: a scalar, a collection, or a
  # typed array. Block openers must be the last token of the line.
  value-start:
    # Empty collections, inline form.
    - match: '(\{)(\})(?={{eol}})'
      captures:
        1: punctuation.section.mapping.begin.riffle
        2: punctuation.section.mapping.end.riffle
    - match: '(\[)(\])(?={{eol}})'
      captures:
        1: punctuation.section.array.begin.riffle
        2: punctuation.section.array.end.riffle
    # Nonempty collections, block form.
    - match: '\{(?={{eol}})'
      scope: punctuation.section.mapping.begin.riffle
      push: map-body
    - match: '\[(?={{eol}})'
      scope: punctuation.section.array.begin.riffle
      push: array-body

    - include: typed-array-openers

    # `@null` takes no payload.
    - match: '(@)(null)(?![A-Za-z0-9_.-])(?={{eol}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: constant.language.null.riffle
    # `@string` with a quoted payload.
    - match: '(@)(string)(?![A-Za-z0-9_.-])([ \t]+)(")'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.string.riffle
        4: punctuation.definition.string.begin.riffle
      push: quoted-value-body
    # `@string` with a bare payload; `@string @int 1` is the string `@int 1`.
    - match: '(@)(string)(?![A-Za-z0-9_.-])([ \t]+)({{bare_string}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.string.riffle
        4: string.unquoted.riffle
    # `@int`, `@long`, `@decimal` and `@boolean` require a space and a payload.
    - match: '(@)(int)(?![A-Za-z0-9_.-])([ \t]+)({{integer}})(?={{eol}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.int.riffle
        4: constant.numeric.integer.int.riffle
    - match: '(@)(long)(?![A-Za-z0-9_.-])([ \t]+)({{integer}})(?={{eol}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.long.riffle
        4: constant.numeric.integer.long.riffle
    - match: '(@)(decimal)(?![A-Za-z0-9_.-])([ \t]+)({{decimal}})(?={{eol}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.decimal.riffle
        4: constant.numeric.decimal.riffle
    - match: '(@)(boolean)(?![A-Za-z0-9_.-])([ \t]+)(true|false)(?={{eol}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.boolean.riffle
        4: constant.language.boolean.riffle

    # A quoted value: the closing delimiter is chosen inside the context.
    - match: '"'
      scope: punctuation.definition.string.begin.riffle
      push: quoted-value-body

    # A type marker that is known but whose payload is missing or malformed.
    - match: '@(?:null|string|int|long|decimal|boolean)(?![A-Za-z0-9_.-]).*$'
      scope: invalid.illegal.typed-value.riffle
    # A type marker that names no known type.
    - match: '@[A-Za-z][A-Za-z0-9_]*'
      scope: invalid.illegal.unknown-type.riffle

    # `{`, `[`, `}` and `]` are reserved at the start of a value, and a
    # nonempty collection may not be written inline.
    - match: '\{[ \t]*\}'
      scope: invalid.illegal.empty-collection-whitespace.riffle
    - match: '\[[ \t]*\]'
      scope: invalid.illegal.empty-collection-whitespace.riffle
    - match: '\{'
      scope: invalid.illegal.unsupported-inline-collection.riffle
    - match: '\['
      scope: invalid.illegal.unsupported-inline-collection.riffle
    - match: '[}\]]'
      scope: invalid.illegal.unexpected-closer.riffle

    # Anything else is a bare string; the negative lookahead keeps the reserved
    # leading characters out of it.
    - match: '(?=[^\s"@\[\]{}])({{bare_string}})'
      captures:
        1: string.unquoted.riffle

  # `@type [` and `@type []` for every element kind. A block typed array pushes
  # the body for that kind; the inline empty form is closed by the `]` rule of
  # that body, which is why the opener also accepts a directly following `]`.
  typed-array-openers:
    - match: '(@)(string)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.string.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-string-body
    - match: '(@)(int)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.int.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-int-body
    - match: '(@)(long)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.long.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-long-body
    - match: '(@)(decimal)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.numeric.decimal.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-decimal-body
    - match: '(@)(boolean)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.boolean.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-boolean-body
    - match: '(@)(null)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.null.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-null-body
    - match: '(@)(map)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.map.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-map-body
    - match: '(@)(array)([ \t]+)(\[)(?={{typed_array_open}})'
      captures:
        1: punctuation.definition.annotation.riffle
        2: storage.type.array.riffle
        4: punctuation.section.array.begin.riffle
      push: typed-array-array-body

  # Rules shared by every typed array body: comments, the closing `]`, and a
  # `}` that closes the wrong collection. The closer is not anchored to the
  # start of the line so that `@type []` can close on the opener line.
  typed-array-common:
    - include: comments
    - include: inline-comment
    - match: '\]'
      scope: punctuation.section.array.end.riffle
      pop: true
    - match: '\}'
      scope: invalid.illegal.mismatched-closer.riffle

  # Elements of a `@string [` array are strings, quoted or bare; a line that
  # starts with a reserved character must be quoted.
  typed-array-string-body:
    - include: typed-array-common
    - match: '"'
      scope: punctuation.definition.string.begin.riffle
      push: quoted-value-body
    - match: '(?=[^\s"@\[\]{}])({{bare_string}})'
      captures:
        1: string.unquoted.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  # Elements of a `@int [` array are bare integers without a repeated marker.
  typed-array-int-body:
    - include: typed-array-common
    - match: '({{integer}})(?={{eol}})'
      captures:
        1: constant.numeric.integer.int.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  typed-array-long-body:
    - include: typed-array-common
    - match: '({{integer}})(?={{eol}})'
      captures:
        1: constant.numeric.integer.long.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  typed-array-decimal-body:
    - include: typed-array-common
    - match: '({{decimal}})(?={{eol}})'
      captures:
        1: constant.numeric.decimal.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  typed-array-boolean-body:
    - include: typed-array-common
    - match: '(true|false)(?={{eol}})'
      captures:
        1: constant.language.boolean.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  # The only legal element of a `@null [` array is the literal `null`.
  typed-array-null-body:
    - include: typed-array-common
    - match: '(null)(?={{eol}})'
      captures:
        1: constant.language.null.riffle
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  typed-array-map-body:
    - include: typed-array-common
    - match: '(\{)(\})(?={{eol}})'
      captures:
        1: punctuation.section.mapping.begin.riffle
        2: punctuation.section.mapping.end.riffle
    - match: '\{(?={{eol}})'
      scope: punctuation.section.mapping.begin.riffle
      push: map-body
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  # Elements of a `@array [` array are arrays or nested typed arrays.
  typed-array-array-body:
    - include: typed-array-common
    - match: '(\[)(\])(?={{eol}})'
      captures:
        1: punctuation.section.array.begin.riffle
        2: punctuation.section.array.end.riffle
    - match: '\[(?={{eol}})'
      scope: punctuation.section.array.begin.riffle
      push: array-body
    - include: typed-array-openers
    - match: '\S(?:.*?)(?={{eol}})'
      scope: invalid.illegal.array-element.riffle

  # Interior of a quoted value. The closing delimiter is the first quote that
  # is followed by nothing but whitespace and an optional inline comment;
  # every other quote is literal data, which is how `"He said "hello""` and
  # `"a # b" # trailing` are read.
  quoted-value-body:
    - meta_scope: string.quoted.double.riffle
    - match: '"(?={{eol}})'
      scope: punctuation.definition.string.end.riffle
      pop: true
    # A backslash before a closing quote that ends the line leaves an
    # unfinished escape, so `x = "abc\"` is INVALID_ESCAPE. When an inline
    # comment follows instead, that quote is interior data and the escape is
    # valid: `x = "a\" # text"` is the string `a" # text`.
    - match: '\\"(?=[ \t]*$)'
      scope: invalid.illegal.escape.riffle
      pop: true
    - include: string-escapes
    - match: '"'
      scope: punctuation.definition.string.quote.riffle
    - match: '(?=$)'
      pop: true

  # The supported escapes are exactly \" \\ \n \r \t \b \f and \uXXXX, with
  # surrogate pairs written as two consecutive escapes.
  string-escapes:
    - match: '\\u[Dd][89ABab][0-9A-Fa-f]{2}\\u[Dd][C-Fc-f][0-9A-Fa-f]{2}'
      scope: constant.character.escape.riffle
    # An isolated surrogate escape is invalid.
    - match: '\\u[Dd][89A-Fa-f][0-9A-Fa-f]{2}'
      scope: invalid.illegal.escape.riffle
    - match: '\\u[0-9A-Fa-f]{4}'
      scope: constant.character.escape.riffle
    - match: '\\u(?:[0-9A-Fa-f]{1,3})?[^0-9A-Fa-f]'
      scope: invalid.illegal.escape.riffle
    - match: '\\u$'
      scope: invalid.illegal.escape.riffle
    - match: '\\["\\nrtbf]'
      scope: constant.character.escape.riffle
    - match: '\\'
      scope: invalid.illegal.escape.riffle
