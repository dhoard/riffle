# SYNTAX TEST "Packages/Riffle/Riffle.sublime-syntax"

schemaVersion : 1
#^^^^^^^^^^^^ entity.name.tag.riffle
#             ^ keyword.operator.assignment.riffle
#               ^ string.unquoted.riffle

name : hello world
#      ^^^^^^^^^^^ string.unquoted.riffle

reserved : @scope/name
#          ^^^^^^^^^^^ invalid.illegal.reserved-value.riffle

scoped : "@scope/name"
#         ^^^^^^^^^^^ string.quoted.double.riffle

# a comment line
# ^^^^^^^^^^^^^^ comment.line.number-sign.riffle

slashed : value // not a comment
#         ^^^^^^^^^^^^^^^^^^^^ string.unquoted.riffle

url : https://example.org/a#fragment
#     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted.riffle

pattern : path//segment
#         ^^^^^^^^^^^^^ string.unquoted.riffle

hashed : hello#world # also data
#        ^^^^^^^^^^^^^^^^^^^^^ string.unquoted.riffle

quoted : "He said "hello""
#        ^ punctuation.definition.string.begin.riffle
#         ^^^^^^^ string.quoted.double.riffle
#                 ^ punctuation.definition.string.quote.riffle
#                  ^^^^^ string.quoted.double.riffle
#                        ^ punctuation.definition.string.end.riffle

hashComment : "a # b"
#             ^ punctuation.definition.string.begin.riffle
#              ^^^^^ string.quoted.double.riffle
#                   ^ punctuation.definition.string.end.riffle

escaped : "tab\t unicode\u263A bad\q"
#             ^^ constant.character.escape.riffle
#                       ^^^^^^ constant.character.escape.riffle
#                                 ^ invalid.illegal.escape.riffle

"schema.version" : Jane
#^^^^^^^^^^^^^^ string.quoted.double.riffle
#                ^ keyword.operator.assignment.riffle
#                  ^^^^ string.unquoted.riffle

emptyMap : {}
#          ^ punctuation.section.mapping.begin.riffle

emptyArray : []
#            ^ punctuation.section.array.begin.riffle

single : """abc"""
#        ^ punctuation.definition.string.begin.riffle
#                ^ punctuation.definition.string.end.riffle

certificate : """
#             ^^^ punctuation.definition.string.begin.riffle
    # not a comment \n
#   ^^^^^^^^^^^^^^^^^^ string.quoted.triple.riffle
#                   ^^ - constant.character.escape.riffle
    /#
#   ^^ string.quoted.triple.riffle - comment.block.riffle
    #/
#   ^^ string.quoted.triple.riffle - comment.block.riffle
    """x
#   ^^^^ string.quoted.triple.riffle
    """
#   ^^^ punctuation.definition.string.end.riffle

capabilities : {
#              ^ punctuation.section.mapping.begin.riffle

    host : localhost
#   ^^^^ entity.name.tag.riffle

    verbose : yes
#             ^^^ string.unquoted.riffle

    nested : {
#            ^ punctuation.section.mapping.begin.riffle

        port : 8080
#              ^^^^ string.unquoted.riffle

    }
#   ^ punctuation.section.mapping.end.riffle

    values : [
#            ^ punctuation.section.array.begin.riffle

        """
#       ^^^ punctuation.definition.string.begin.riffle
        element
#       ^^^^^^^ string.quoted.triple.riffle
        """
#       ^^^ punctuation.definition.string.end.riffle

        true
#       ^^^^ string.unquoted.riffle

    ]
#   ^ punctuation.section.array.end.riffle

}

bad : @int 1
#     ^^^^^^ invalid.illegal.reserved-value.riffle

inline : [ one ]
#        ^ invalid.illegal.unsupported-inline-collection.riffle

# block comment regions occupy whole lines and nest
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.line.number-sign.riffle
/#
#^ comment.block.riffle
disabled : {
#^^^^^^^^^^ comment.block.riffle
/#
#^ comment.block.riffle
"""
#^^ comment.block.riffle - punctuation.definition.string.begin.riffle
deeper : @int not-a-number
#^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.block.riffle
#/
#^ comment.block.riffle
#/
#^ comment.block.riffle

after : value
#^^^^ entity.name.tag.riffle
