# Example AI harness settings
name : Amanda
provider : anthropic
greeting : "  Hello!  "

model : {
    name : claude-sonnet
    temperature : 0.7
    maxTokens : 8192
}

tools : [
    bash
    read
    edit
    write
]

permissions : {
    shell : {
        enabled : true
        timeoutMillis : 60000
    }
    network : {}
}

prompts : [
    # A raw block keeps every character literally, across as many lines as it needs.
    """
    Use punctuation freely: # ; : [ ] { } =
    Continue on the next line.
    """

    # Quotes preserve leading and trailing whitespace.
    "Preserve this leading whitespace:  "
]
